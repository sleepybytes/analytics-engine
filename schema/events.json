{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentEvent",
  "description": "Union of all agent trace event types",
  "oneOf": [
    { "$ref": "#/definitions/TraceStartedEvent" },
    { "$ref": "#/definitions/TraceCompletedEvent" },
    { "$ref": "#/definitions/LLMCallEvent" },
    { "$ref": "#/definitions/ToolCallEvent" },
    { "$ref": "#/definitions/ErrorEvent" },
    { "$ref": "#/definitions/RetryEvent" },
    { "$ref": "#/definitions/StepCompletedEvent" }
  ],
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["event_id", "trace_id", "timestamp", "event_type"],
      "properties": {
        "event_id":   { "type": "string", "description": "UUID v4 — idempotency key" },
        "trace_id":   { "type": "string", "description": "UUID v4 — groups all events in one agent run" },
        "timestamp":  { "type": "string", "format": "date-time", "description": "ISO 8601, set by SDK at capture time" },
        "event_type": { "type": "string" }
      }
    },
    "TraceStartedEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "agent_name"],
          "properties": {
            "event_type":  { "type": "string", "enum": ["trace_started"] },
            "agent_name":  { "type": "string" },
            "user_id":     { "type": "string" },
            "session_id":  { "type": "string" },
            "input":       { "type": "string" },
            "tags":        { "type": "array", "items": { "type": "string" } },
            "metadata":    { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "TraceCompletedEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "agent_name", "status", "duration_ms", "total_steps",
                       "total_llm_calls", "total_tool_calls", "total_input_tokens", "total_output_tokens"],
          "properties": {
            "event_type":          { "type": "string", "enum": ["trace_completed"] },
            "agent_name":          { "type": "string" },
            "status":              { "type": "string", "enum": ["success", "error", "timeout", "cancelled"] },
            "output":              { "type": "string" },
            "duration_ms":         { "type": "integer", "minimum": 0 },
            "total_steps":         { "type": "integer", "minimum": 0 },
            "total_llm_calls":     { "type": "integer", "minimum": 0 },
            "total_tool_calls":    { "type": "integer", "minimum": 0 },
            "total_input_tokens":  { "type": "integer", "minimum": 0 },
            "total_output_tokens": { "type": "integer", "minimum": 0 },
            "total_cost_usd":      { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "LLMCallEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "model", "provider", "step_index", "latency_ms", "input_tokens", "output_tokens"],
          "properties": {
            "event_type":   { "type": "string", "enum": ["llm_call"] },
            "model":        { "type": "string", "description": "e.g. gpt-4o, claude-sonnet-4-5" },
            "provider":     { "type": "string", "description": "openai | anthropic | google" },
            "step_index":   { "type": "integer", "minimum": 0 },
            "latency_ms":   { "type": "integer", "minimum": 0 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens":{ "type": "integer", "minimum": 0 },
            "cost_usd":     { "type": "number", "minimum": 0 },
            "status":       { "type": "string", "enum": ["success", "error", "timeout"], "default": "success" },
            "error_type":   { "type": "string" },
            "temperature":  { "type": "number", "minimum": 0, "maximum": 2 },
            "cached":       { "type": "boolean" }
          }
        }
      ]
    },
    "ToolCallEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "tool_name", "step_index", "latency_ms", "status"],
          "properties": {
            "event_type":    { "type": "string", "enum": ["tool_call"] },
            "tool_name":     { "type": "string" },
            "step_index":    { "type": "integer", "minimum": 0 },
            "latency_ms":    { "type": "integer", "minimum": 0 },
            "status":        { "type": "string", "enum": ["success", "error", "timeout"] },
            "error_type":    { "type": "string" },
            "retry_count":   { "type": "integer", "minimum": 0 },
            "input_summary": { "type": "string" }
          }
        }
      ]
    },
    "ErrorEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "error_type", "message", "recoverable"],
          "properties": {
            "event_type":  { "type": "string", "enum": ["error"] },
            "error_type":  { "type": "string", "description": "rate_limit | context_length | tool_failure" },
            "message":     { "type": "string" },
            "step_index":  { "type": "integer", "minimum": 0 },
            "recoverable": { "type": "boolean" }
          }
        }
      ]
    },
    "RetryEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "reason", "attempt_number"],
          "properties": {
            "event_type":     { "type": "string", "enum": ["retry"] },
            "reason":         { "type": "string" },
            "attempt_number": { "type": "integer", "minimum": 1 },
            "step_index":     { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "StepCompletedEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["event_type", "step_index", "step_type", "duration_ms"],
          "properties": {
            "event_type":  { "type": "string", "enum": ["step_completed"] },
            "step_index":  { "type": "integer", "minimum": 0 },
            "step_type":   { "type": "string", "description": "planning | execution | reflection" },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "status":      { "type": "string", "enum": ["success", "error"], "default": "success" }
          }
        }
      ]
    }
  }
}
