# ── API ───────────────────────────────────────────────────────────────────────
DB_PATH=/data/analytics.duckdb
LOG_LEVEL=info                        # debug | info | warning | error

# ── Project credentials ───────────────────────────────────────────────────────
# Dev defaults — generate real values for production
PROJECT_API_KEY=dev_project_key
PROJECT_ID=proj_dev_001

# ── Alerts ────────────────────────────────────────────────────────────────────
# POST to this URL whenever an NL query fails to match a known metric.
# Works with Slack, Discord, PagerDuty, or any custom HTTP endpoint.
# Unset → webhook disabled; DB logging (nl_miss_log) always happens.
#
# Slack:     https://hooks.slack.com/services/T.../B.../...
# Discord:   https://discord.com/api/webhooks/.../...
# PagerDuty: https://events.pagerduty.com/v2/enqueue
ALERT_WEBHOOK_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite bakes this into the JS bundle at build time
VITE_API_KEY=dev_project_key

# ── Simulator ─────────────────────────────────────────────────────────────────
API_URL=http://localhost:8080
API_KEY=dev_project_key
